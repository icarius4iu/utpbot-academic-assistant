# === Configuración de Google Sheets ===
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=your_spreadsheet_id_here

# === Configuración de Google Gemini ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === Configuración de JWT ===
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_secure_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# === Configuración del Administrador ===
# Credenciales del panel de administración (NO compartir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate_a_secure_password_here

# === Configuración del servidor ===
# Orígenes permitidos (separados por coma, sin espacios)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500
DEBUG=false

# === Telegram Bot ===
# Token obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# URL pública del backend (para configurar el webhook)
TELEGRAM_WEBHOOK_URL=https://your-backend.railway.app/telegram/webhook
